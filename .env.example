DB_NAME=wachcio_ogrod
DB_USER=ogrod_user
DB_PASSWORD=zmien_to_haslo
DB_ROOT_PASSWORD=zmien_to_haslo_root

# Domyślnie (bez ustawiania poniższych) aplikacja zakłada, że otwierasz ją
# w przeglądarce na tym samym komputerze, na którym stoi Docker
# ("localhost"). Jeśli uruchamiasz to na innej maszynie/kontenerze LXC,
# ustaw obie zmienne poniżej na adres, pod którym FAKTYCZNIE otwierasz
# stronę w przeglądarce - inaczej przeglądarka będzie próbować łączyć się
# z "localhost" czyli samą sobą, a logowanie/rejestracja nigdy się nie
# powiedzie (request nie dotrze do backendu).
#
# Wariant "bezpośrednio po IP/porcie" (bez reverse proxy):
# FRONTEND_ORIGIN=http://192.168.1.50:5173
# VITE_API_URL=http://192.168.1.50:8080/api
#
# Wariant "przez reverse proxy pod własną domeną" (np. nginx/Traefik
# przekierowujący https://ogrod.wachcio.dom -> :5173 i
# https://api.ogrod.wachcio.dom -> :8080 - bez portów w adresach, proxy
# je dodaje po swojej stronie):
# FRONTEND_ORIGIN=https://ogrod.wachcio.dom
# VITE_API_URL=https://api.ogrod.wachcio.dom/api

# Własna nazwa hosta/domena (jak wyżej) musi też trafić tutaj - Vite
# domyślnie blokuje nieznane nagłówki Host (ochrona przed DNS rebinding)
# i bez tego zobaczysz błąd "Blocked request. This host is not allowed."
# Można podać kilka wartości oddzielonych przecinkiem. Dotyczy tylko
# frontendu (VITE_ALLOWED_HOSTS) - domena API tu nie jest potrzebna.
# VITE_ALLOWED_HOSTS=ogrod.wachcio.dom
